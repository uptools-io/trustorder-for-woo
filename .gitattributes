# Keep development files out of the Composer dist, GitHub "Download ZIP" and
# the release ZIP (bin/build-zip.sh builds from `git archive`).
/tests	export-ignore
/docs	export-ignore
/src	export-ignore
/bin	export-ignore
/dist	export-ignore
/.superpowers	export-ignore
/.claude	export-ignore
/.github	export-ignore
/.gitattributes	export-ignore
/.gitignore	export-ignore
/phpcs.xml.dist	export-ignore
/phpstan.neon.dist	export-ignore
/phpstan-baseline.neon	export-ignore
/phpstan-bootstrap.php	export-ignore
/phpunit.xml.dist	export-ignore
/strauss.phar	export-ignore
/package.json	export-ignore
/package-lock.json	export-ignore
