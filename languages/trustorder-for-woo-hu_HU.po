#~ msgid "What do the levels mean?"
#~ msgstr "Mit jelentenek a szintek?"

#~ msgid "How TrustOrder works"
#~ msgstr "Hogyan működik a TrustOrder"

#~ msgid ""
#~ "When the buyer fills in the checkout, TrustOrder looks up the e-mail "
#~ "address, phone number and delivery address in the shared network of shops."
#~ msgstr ""
#~ "Amikor a vásárló kitölti a pénztárat, a TrustOrder megnézi az e-mail-"
