{
    "name": "uptools-io/trustorder-for-woo",
    "description": "Cash-on-delivery buyer reputation for WooCommerce from hashed identities (TrustOrder API client).",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "uptools.io",
            "homepage": "https://uptools.io"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "giggsey/libphonenumber-for-php-lite": "9.0.42",
        "php-stubs/woocommerce-stubs": "^11.1",
        "php-stubs/wp-cli-stubs": "^2.12",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/phpstan": "^1.11",
        "phpunit/phpunit": "^9.6",
        "squizlabs/php_codesniffer": "^3.0",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "wp-coding-standards/wpcs": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "LightweightPlugins\\TrustOrder\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LightweightPlugins\\TrustOrder\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.1.31"
        }
    },
    "scripts": {
        "phpcs": "phpcs",
        "phpcbf": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=2G",
        "test": "phpunit",
        "strauss": [
            "test -f strauss.phar || curl -fsSL -o strauss.phar https://github.com/BrianHenryIE/strauss/releases/download/0.31.1/strauss.phar",
            "@php strauss.phar"
        ]
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "LightweightPlugins\\TrustOrder\\Vendor\\",
            "classmap_prefix": "LightweightPlugins_TrustOrder_Vendor_",
            "constant_prefix": "TRUSTORDER_VENDOR_",
            "packages": [
                "giggsey/libphonenumber-for-php-lite"
            ],
            "update_call_sites": false,
            "delete_vendor_packages": false
        }
    }
}
